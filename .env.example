# Copy to api/.env (API) and web/.env.local (website). Never commit real values.

# ---- API (api/.env, HF Space secrets) ----
ANTHROPIC_API_KEY=sk-ant-...                 # group key; model is fixed to claude-haiku-5-5
DATABASE_URL_UNPOOLED=postgresql://...       # Neon DIRECT connection (no -pooler) - LangGraph saver/store need it
SERVICE_TOKEN=change-me-long-random          # shared secret between website and API internal endpoints
SPEND_CAP_USD=1.60                           # degraded reply once estimated LLM spend reaches this
DEALER_TZ=Asia/Karachi
ADMIN_EMAIL=admin@apexmotors.demo            # seed script only
ADMIN_PASSWORD=                              # seed script only (bcrypt-hashed into the users table)

# ---- Website (web/.env.local, Vercel env) ----
DATABASE_URL=postgresql://...-pooler...      # Neon POOLED connection for serverless functions
AUTH_SECRET=change-me-at-least-32-chars      # HS256 session signing key
SERVICE_TOKEN=change-me-long-random          # same value as the API
AGENT_API_URL=https://<hf-user>-dealcloser-api.hf.space
NEXT_PUBLIC_SITE_NAME=Apex Motors
